    // Meret (item 90000004: picking it up adds it to your Meret, no pouch to open), a random amount from Amount to MaxAmount.
    // Normal monsters by level; bosses (BossChance, BossMultiplier) always 1-1,000 Meret, often 1-500 and sometimes 1-1,000 more.
    { "ItemId": 90000004, "Name": "1-10 Meret",                 "MinLevel": 1, "MaxLevel": 49,  "Chance": 0.50, "BossChance": 0,    "Amount": 1, "MaxAmount": 10,   "AmountPerLevel": 0 },
    { "ItemId": 90000004, "Name": "1-100 Meret",                "MinLevel": 50, "MaxLevel": 69, "Chance": 0.10, "BossChance": 0,    "Amount": 1, "MaxAmount": 100,  "AmountPerLevel": 0 },
    { "ItemId": 90000004, "Name": "1-100 Meret",                "MinLevel": 70,                 "Chance": 0.20, "BossChance": 0,    "Amount": 1, "MaxAmount": 100,  "AmountPerLevel": 0 },
    { "ItemId": 90000004, "Name": "1-1,000 Meret (boss)",       "MinLevel": 1,                  "Chance": 0,    "BossChance": 1,    "Amount": 1, "MaxAmount": 1000, "AmountPerLevel": 0, "BossMultiplier": 1 },
    { "ItemId": 90000004, "Name": "1-500 Meret (boss)",         "MinLevel": 1,                  "Chance": 0,    "BossChance": 0.60, "Amount": 1, "MaxAmount": 500,  "AmountPerLevel": 0, "BossMultiplier": 1 },
