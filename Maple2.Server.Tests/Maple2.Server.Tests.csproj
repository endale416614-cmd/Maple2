<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>12</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Maple2.Lua" Version="2.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="7.0.3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Maple2.File.Ingest\Maple2.File.Ingest.csproj" Aliases="ingest" />
      <ProjectReference Include="..\Maple2.Server.Game\Maple2.Server.Game.csproj" />
    </ItemGroup>

    <!-- The ingest and the parser package declare the Maple2.File namespace, which would shadow System.IO.File in every test. -->
    <Target Name="AliasIngestReferences" BeforeTargets="FindReferenceAssembliesForReferences">
        <ItemGroup>
            <ReferencePath Condition="'%(ReferencePath.NuGetPackageId)' == 'Maple2.File.Parser.Tadeucci'">
                <Aliases>ingest</Aliases>
            </ReferencePath>
        </ItemGroup>
    </Target>

</Project>
