# Maple2.File.Ingest

# Local (non-docker) path to your MapleStory2 Data folder.
# When running under docker, comment this out so it doesn't override the
# container's MS2_DATA_FOLDER (/ClientData) via DotEnv.Load().
MS2_DATA_FOLDER=C:/Nexon/Library/maplestory2/Data/

# Docker only: path on the host to your MapleStory2 Data folder.
# Mounted into the file-ingest container at /ClientData.
# MS2_DOCKER_DATA_FOLDER=/path/to/maplestory2/Data

# Primary language. Mainly used for searching on black market, commands, etc.
# EN, KR, CN, JP, DE, PR
LANGUAGE=EN

# Database connection

# To run with docker, comment out DB_IP below: every compose service passes
# DB_IP=mysql itself, and file-ingest's DotEnv.Load() would otherwise override
# it with this host value and break the container's database connection.
DB_IP=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=maplestory

DATA_DB_NAME=maple-data
GAME_DB_NAME=game-server

# Maple2.Server - Only needed if hosting for external access

GAME_IP=127.0.0.1
LOGIN_IP=127.0.0.1

GRPC_GAME_IP=127.0.0.1
GRPC_WORLD_IP=127.0.0.1
GRPC_WORLD_PORT=21001
GRPC_LOGIN_IP=127.0.0.1

WEB_IP=127.0.0.1
# Web server listen port; the same port is published by compose. Change it here
# if the default is already in use on the host.
WEB_PORT=4000
